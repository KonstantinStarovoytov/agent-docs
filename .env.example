# Copy to .env; never commit credentials.
OPENAI_API_KEY=
COHERE_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

QDRANT_URL=http://localhost:6333
# Required by Qdrant Cloud, unused by a local container.
QDRANT_API_KEY=
QDRANT_COLLECTION=agent_docs_v2
QDRANT_HYBRID_COLLECTION=agent_docs_hybrid_v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
SPARSE_EMBEDDING_MODEL=Qdrant/bm25
COHERE_RERANK_MODEL=rerank-v4.0-fast
OPENAI_CHAT_MODEL=gpt-6-luna
# Evals only: the LLM judge, never the generator. A claude- model needs
# ANTHROPIC_API_KEY (Anthropic's OpenAI-compatible API).
JUDGE_MODEL=gpt-6-sol
# ANTHROPIC_API_KEY=

# Bearer token for the HTTP endpoint and the MCP HTTP transport. The server
# refuses to start without it; every request spends OpenAI and Cohere credits.
API_TOKEN=
# Optional second token to hand out to people trying the service. Same rights
# and rate limit as API_TOKEN; revoke it by clearing the variable.
API_GUEST_TOKEN=
API_MAX_QUESTION_CHARS=500
# Public hostnames, comma-separated. The MCP transport answers 421 to a Host
# header it was not told about, so a deployed domain must be listed here.
# Empty allows localhost only, which is what local development needs.
API_ALLOWED_HOSTS=

TRACING_ENABLED=true
RETRIEVAL_STRATEGY=hybrid
TRANSLATE_NON_ENGLISH=true
RETRIEVAL_TOP_K=10
PER_QUERY_TOP_K=20
GENERATION_TOP_K=5
PROMPT_STRICT=false
# Optional: pin exact Langfuse prompt versions for reproducible experiments.
# ANSWER_PROMPT_VERSION=1
# ANSWER_EVALUATOR_PROMPT_VERSION=1
# TRANSLATE_PROMPT_VERSION=1
# EVIDENCE_PLANNER_PROMPT_VERSION=1
